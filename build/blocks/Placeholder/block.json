{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/placeholder",
  "version": "0.1.0",
  "title": "Placeholder",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Placeholder component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Placeholder label"
    },
    "instructions": {
      "type": "string",
      "default": "Instructions explain what to do with this placeholder."
    },
    "icon": {
      "type": "string",
      "enum": [
        "",
        "cog",
        "check",
        "starFilled",
        "wordpress",
        "image"
      ],
      "default": "starFilled"
    },
    "isColumnLayout": {
      "type": "boolean",
      "default": false
    },
    "withIllustration": {
      "type": "boolean",
      "default": false
    },
    "showNotices": {
      "type": "boolean",
      "default": false
    },
    "showPreview": {
      "type": "boolean",
      "default": false
    },
    "showChildren": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}