{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/color-picker",
  "version": "0.1.0",
  "title": "ColorPicker",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ColorPicker component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "color": {
      "type": "string",
      "default": "#0073aa"
    },
    "enableAlpha": {
      "type": "boolean",
      "default": false
    },
    "copyFormat": {
      "type": "string",
      "enum": [
        "hex",
        "hsl",
        "rgb"
      ],
      "default": "hex"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}