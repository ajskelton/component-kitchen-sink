{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-multiple-origin-colors-and-gradients",
  "version": "0.1.0",
  "title": "__experimentalUseMultipleOriginColorsAndGradients",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the __experimentalUseMultipleOriginColorsAndGradients component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "origin": {
      "type": "string",
      "enum": [
        "all",
        "theme",
        "default",
        "custom"
      ],
      "default": "all"
    },
    "showSwatches": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}