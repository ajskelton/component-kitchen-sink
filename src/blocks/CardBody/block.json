{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/card-body",
	"version": "0.1.0",
	"title": "CardBody",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the CardBody component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"size": {
			"type": "string",
			"enum": [ "none", "xSmall", "small", "medium", "large" ],
			"default": "medium"
		},
		"isShady": {
			"type": "boolean",
			"default": false
		},
		"isScrollable": {
			"type": "boolean",
			"default": false
		},
		"paragraphs": {
			"type": "number",
			"default": 6
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
