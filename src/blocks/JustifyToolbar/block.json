{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/justify-toolbar",
	"version": "0.1.0",
	"title": "JustifyToolbar",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the JustifyToolbar component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"enum": [
				"",
				"left",
				"center",
				"right",
				"space-between",
				"stretch"
			],
			"default": ""
		},
		"allowedControlsSet": {
			"type": "string",
			"enum": [ "default", "all", "left-right" ],
			"default": "default"
		},
		"bottomPopover": {
			"type": "boolean",
			"default": false
		},
		"isCollapsed": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
