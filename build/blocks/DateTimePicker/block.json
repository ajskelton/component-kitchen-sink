{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/date-time-picker",
  "version": "0.1.0",
  "title": "DateTimePicker",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the DateTimePicker component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "currentDate": {
      "type": "string",
      "default": ""
    },
    "is12Hour": {
      "type": "boolean",
      "default": false
    },
    "dateOrder": {
      "type": "string",
      "enum": [
        "mdy",
        "dmy",
        "ymd"
      ],
      "default": "mdy"
    },
    "startOfWeek": {
      "type": "number",
      "enum": [
        0,
        1,
        2,
        3,
        4,
        5,
        6
      ],
      "default": 0
    },
    "disableWeekends": {
      "type": "boolean",
      "default": false
    },
    "showEvents": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}