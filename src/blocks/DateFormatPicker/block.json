{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/date-format-picker",
	"version": "0.1.0",
	"title": "DateFormatPicker",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the DateFormatPicker component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"format": {
			"type": "string",
			"default": ""
		},
		"defaultFormat": {
			"type": "string",
			"default": "M j, Y"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
