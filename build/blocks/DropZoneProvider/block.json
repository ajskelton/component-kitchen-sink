{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/drop-zone-provider",
  "version": "0.1.0",
  "title": "DropZoneProvider",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the DropZoneProvider component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Drop here"
    },
    "drops": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}