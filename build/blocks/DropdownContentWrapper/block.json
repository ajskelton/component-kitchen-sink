{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/dropdown-content-wrapper",
  "version": "0.1.0",
  "title": "DropdownContentWrapper",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the DropdownContentWrapper component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "paddingSize": {
      "type": "string",
      "enum": [
        "none",
        "small",
        "medium"
      ],
      "default": "small"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}