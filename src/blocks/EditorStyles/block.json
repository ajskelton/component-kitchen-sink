{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/editor-styles",
	"version": "0.1.0",
	"title": "EditorStyles",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the EditorStyles component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"blockCount": {
			"type": "number",
			"default": 2
		},
		"css": {
			"type": "string",
			"default": "p { color: #cc1818; font-style: italic; }"
		},
		"scope": {
			"type": "string",
			"default": ".ajs-editor-styles-scope"
		},
		"applyScope": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
