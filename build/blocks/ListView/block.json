{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/list-view",
  "version": "0.1.0",
  "title": "ListView",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ListView component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "showBlockMovers": {
      "type": "boolean",
      "default": false
    },
    "isExpanded": {
      "type": "boolean",
      "default": false
    },
    "showAppender": {
      "type": "boolean",
      "default": false
    },
    "showContentPopover": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}