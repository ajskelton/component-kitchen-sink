{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/focusable-iframe",
	"version": "0.1.0",
	"title": "FocusableIframe",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the FocusableIframe component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"title": {
			"type": "string",
			"default": "FocusableIframe demo"
		},
		"height": {
			"type": "number",
			"default": 120
		},
		"focusCount": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
