{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/style-provider",
	"version": "0.1.0",
	"title": "StyleProvider",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the StyleProvider component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"useCanvasDocument": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": "Styled by StyleProvider"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
