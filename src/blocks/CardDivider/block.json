{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/card-divider",
	"version": "0.1.0",
	"title": "CardDivider",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the CardDivider component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"margin": {
			"type": "string",
			"default": ""
		},
		"marginStart": {
			"type": "string",
			"default": ""
		},
		"marginEnd": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
