{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/icon",
	"version": "0.1.0",
	"title": "Icon",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Icon component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"icon": {
			"type": "string",
			"enum": [
				"wordpress",
				"cog",
				"check",
				"plus",
				"starFilled",
				"trash",
				"dashicon:smiley",
				"dashicon:admin-site"
			],
			"default": "wordpress"
		},
		"size": {
			"type": "number",
			"default": 24
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
