{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/button",
	"version": "0.1.0",
	"title": "Button",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Button component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": "Button"
		},
		"variant": {
			"type": "string",
			"enum": [ "primary", "secondary", "tertiary", "link" ],
			"default": "primary"
		},
		"size": {
			"type": "string",
			"enum": [ "default", "compact", "small" ],
			"default": "default"
		},
		"isDestructive": {
			"type": "boolean",
			"default": false
		},
		"disabled": {
			"type": "boolean",
			"default": false
		},
		"icon": {
			"type": "string",
			"default": ""
		},
		"iconPosition": {
			"type": "string",
			"enum": [ "left", "right" ],
			"default": "left"
		},
		"clicks": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
