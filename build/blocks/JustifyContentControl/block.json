{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/justify-content-control",
  "version": "0.1.0",
  "title": "JustifyContentControl",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the JustifyContentControl component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "value": {
      "type": "string",
      "enum": [
        "",
        "left",
        "center",
        "right",
        "space-between",
        "stretch"
      ],
      "default": ""
    },
    "allowedControlsSet": {
      "type": "string",
      "enum": [
        "default",
        "all",
        "left-right"
      ],
      "default": "default"
    },
    "bottomPopover": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}