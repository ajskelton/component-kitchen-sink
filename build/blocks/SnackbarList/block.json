{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/snackbar-list",
  "version": "0.1.0",
  "title": "SnackbarList",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the SnackbarList component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "notices": {
      "type": "array",
      "default": []
    },
    "nextId": {
      "type": "number",
      "default": 1
    },
    "newContent": {
      "type": "string",
      "default": "Snackbar"
    },
    "explicitDismiss": {
      "type": "boolean",
      "default": true
    },
    "withAction": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}