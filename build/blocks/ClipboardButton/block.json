{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/clipboard-button",
  "version": "0.1.0",
  "title": "ClipboardButton",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ClipboardButton component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": "Copied from the ClipboardButton block"
    },
    "variant": {
      "type": "string",
      "enum": [
        "primary",
        "secondary",
        "tertiary"
      ],
      "default": "secondary"
    },
    "copies": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}