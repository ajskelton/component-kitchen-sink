{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/toggle-control",
  "version": "0.1.0",
  "title": "ToggleControl",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ToggleControl component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "checked": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string",
      "default": "Toggle"
    },
    "help": {
      "type": "string",
      "default": ""
    },
    "dynamicHelp": {
      "type": "boolean",
      "default": false
    },
    "disabled": {
      "type": "boolean",
      "default": false
    },
    "className": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}