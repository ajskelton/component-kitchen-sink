{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/plain-text",
	"version": "0.1.0",
	"title": "PlainText",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the PlainText component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"content": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": "Write plain text..."
		},
		"disabled": {
			"type": "boolean",
			"default": false
		},
		"readOnly": {
			"type": "boolean",
			"default": false
		},
		"spellCheck": {
			"type": "boolean",
			"default": true
		},
		"maxLength": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
