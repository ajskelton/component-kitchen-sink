{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/use-autocomplete-props",
	"version": "0.1.0",
	"title": "__unstableUseAutocompleteProps",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the __unstableUseAutocompleteProps component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"triggerPrefix": {
			"type": "string",
			"default": "#"
		},
		"optionSet": {
			"type": "string",
			"enum": [ "colors", "animals" ],
			"default": "colors"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
