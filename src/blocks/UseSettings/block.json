{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/use-settings",
	"version": "0.1.0",
	"title": "useSettings",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the useSettings component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"paths": {
			"type": "string",
			"default": "color.custom, spacing.units, typography.dropCap, layout.contentSize"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
