{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-slot-fills",
  "version": "0.1.0",
  "title": "__experimentalUseSlotFills",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the __experimentalUseSlotFills component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "slotName": {
      "type": "string",
      "default": "ajs-use-slot-fills"
    },
    "fillCount": {
      "type": "number",
      "default": 2
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}