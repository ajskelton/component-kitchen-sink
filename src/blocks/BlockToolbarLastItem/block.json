{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/block-toolbar-last-item",
	"version": "0.1.0",
	"title": "BlockToolbarLastItem",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the BlockToolbarLastItem component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"enabled": {
			"type": "boolean",
			"default": true
		},
		"label": {
			"type": "string",
			"default": "Last toolbar item from kitchen sink"
		},
		"clicks": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
