{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/card-header",
	"version": "0.1.0",
	"title": "CardHeader",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the CardHeader component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"size": {
			"type": "string",
			"enum": [ "none", "xSmall", "small", "medium", "large" ],
			"default": "medium"
		},
		"isBorderless": {
			"type": "boolean",
			"default": false
		},
		"isShady": {
			"type": "boolean",
			"default": false
		},
		"justify": {
			"type": "string",
			"enum": [
				"flex-start",
				"center",
				"flex-end",
				"space-between",
				"space-around",
				"space-evenly"
			],
			"default": "space-between"
		},
		"gap": {
			"type": "number",
			"default": 2
		},
		"title": {
			"type": "string",
			"default": "Header title"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
