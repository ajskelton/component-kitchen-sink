{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/component-info",
	"version": "0.1.0",
	"title": "Component Info",
	"category": "ajs-kitchen-sink",
	"icon": "info-outline",
	"description": "Shows where the component this post describes is used by core blocks and how it has changed over time",
	"usesContext": [ "postId", "postType" ],
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false
	},
	"attributes": {},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
