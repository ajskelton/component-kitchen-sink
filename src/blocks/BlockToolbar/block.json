{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/block-toolbar",
	"version": "0.1.0",
	"title": "BlockToolbar",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the BlockToolbar component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"blockCount": {
			"type": "number",
			"default": 2
		},
		"hideDragHandle": {
			"type": "boolean",
			"default": false
		},
		"variant": {
			"type": "string",
			"enum": [ "unstyled", "toolbar" ],
			"default": "unstyled"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
