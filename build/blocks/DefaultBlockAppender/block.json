{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/default-block-appender",
  "version": "0.1.0",
  "title": "DefaultBlockAppender",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the DefaultBlockAppender component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "allowedBlocks": {
      "type": "string",
      "enum": [
        "all",
        "text",
        "none"
      ],
      "default": "all"
    },
    "templateLock": {
      "type": "string",
      "enum": [
        "",
        "all",
        "insert"
      ],
      "default": ""
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}