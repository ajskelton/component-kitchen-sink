{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/block-full-height-aligment-control",
  "version": "0.1.0",
  "title": "BlockFullHeightAligmentControl",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the BlockFullHeightAligmentControl component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "isActive": {
      "type": "boolean",
      "default": false
    },
    "label": {
      "type": "string",
      "default": "Full height"
    },
    "isDisabled": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}