{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/with-focus-return",
  "version": "0.1.0",
  "title": "withFocusReturn",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the withFocusReturn component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "mode": {
      "type": "string",
      "enum": [
        "default",
        "custom"
      ],
      "default": "default"
    },
    "openCount": {
      "type": "number",
      "default": 0
    },
    "customReturns": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}