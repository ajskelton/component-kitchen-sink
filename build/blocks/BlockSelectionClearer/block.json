{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/block-selection-clearer",
  "version": "0.1.0",
  "title": "BlockSelectionClearer",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the BlockSelectionClearer component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "blockCount": {
      "type": "number",
      "default": 2
    },
    "padding": {
      "type": "number",
      "default": 24
    },
    "className": {
      "type": "string",
      "default": "ajs-selection-clearer"
    },
    "clearBlockSelection": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}