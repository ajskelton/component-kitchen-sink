{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/inspector-popover-header",
  "version": "0.1.0",
  "title": "InspectorPopoverHeader",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the InspectorPopoverHeader component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "default": "Popover title"
    },
    "help": {
      "type": "string",
      "default": "Help text shown under the header."
    },
    "actionMode": {
      "type": "string",
      "enum": [
        "none",
        "text",
        "icon",
        "both"
      ],
      "default": "text"
    },
    "showClose": {
      "type": "boolean",
      "default": true
    },
    "actionClicks": {
      "type": "number",
      "default": 0
    },
    "closeClicks": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}