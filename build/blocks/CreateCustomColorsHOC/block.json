{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/create-custom-colors-hoc",
  "version": "0.1.0",
  "title": "createCustomColorsHOC",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the createCustomColorsHOC component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "backgroundColor": {
      "type": "string"
    },
    "customBackgroundColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "customBorderColor": {
      "type": "string"
    },
    "label": {
      "type": "string",
      "default": "Box colored through createCustomColorsHOC"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}