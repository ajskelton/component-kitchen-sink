{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/use-navigator",
	"version": "0.1.0",
	"title": "useNavigator",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the useNavigator component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"target": {
			"type": "string",
			"enum": [ "/", "/child", "/item/42" ],
			"default": "/child"
		},
		"replace": {
			"type": "boolean",
			"default": false
		},
		"skipFocus": {
			"type": "boolean",
			"default": false
		},
		"calls": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
