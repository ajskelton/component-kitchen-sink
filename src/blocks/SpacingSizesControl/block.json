{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/spacing-sizes-control",
	"version": "0.1.0",
	"title": "SpacingSizesControl",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the SpacingSizesControl component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "Padding"
		},
		"values": {
			"type": "object",
			"default": {}
		},
		"sidesPreset": {
			"type": "string",
			"enum": [ "all", "axial", "top-bottom", "top" ],
			"default": "all"
		},
		"showSideInLabel": {
			"type": "boolean",
			"default": true
		},
		"useSelect": {
			"type": "boolean",
			"default": false
		},
		"minimumCustomValue": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
