{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-composite-state",
  "version": "0.1.0",
  "title": "__unstableUseCompositeState",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the __unstableUseCompositeState component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "orientation": {
      "type": "string",
      "enum": [
        "",
        "horizontal",
        "vertical"
      ],
      "default": ""
    },
    "loop": {
      "type": "boolean",
      "default": false
    },
    "wrap": {
      "type": "boolean",
      "default": false
    },
    "shift": {
      "type": "boolean",
      "default": false
    },
    "unstable_virtual": {
      "type": "boolean",
      "default": false
    },
    "rtl": {
      "type": "boolean",
      "default": false
    },
    "currentItem": {
      "type": "string",
      "enum": [
        "",
        "apple",
        "banana",
        "cherry"
      ],
      "default": ""
    },
    "lastPressed": {
      "type": "string",
      "default": ""
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}