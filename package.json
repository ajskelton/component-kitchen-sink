{
	"name": "component-kitchen-sink",
	"version": "0.1.0",
	"description": "Exploring all the component tooling available for blocks",
	"author": "The WordPress Contributors",
	"license": "GPL-2.0-or-later",
	"main": "build/index.js",
	"scripts": {
		"build": "wp-scripts build --webpack-copy-php && node scripts/combine-styles.mjs",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start --webpack-copy-php",
		"create-block": "cd ./src/blocks/ && npx @wordpress/create-block --namespace=ajs --no-plugin --variant=dynamic",
		"combine-styles": "node scripts/combine-styles.mjs"
	},
	"devDependencies": {
		"@wordpress/block-editor": "^19.0.0",
		"@wordpress/blocks": "^17.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/compose": "^9.0.0",
		"@wordpress/data": "^11.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/icons": "^19.0.0",
		"@wordpress/scripts": "^37.0.0"
	}
}
