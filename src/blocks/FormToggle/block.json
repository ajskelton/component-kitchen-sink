{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/form-toggle",
	"version": "0.1.0",
	"title": "FormToggle",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the FormToggle component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"checked": {
			"type": "boolean",
			"default": false
		},
		"disabled": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
