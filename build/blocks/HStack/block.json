{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/h-stack",
  "version": "0.1.0",
  "title": "HStack",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the HStack component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "alignment": {
      "type": "string",
      "enum": [
        "edge",
        "top",
        "topLeft",
        "topRight",
        "left",
        "center",
        "right",
        "bottom",
        "bottomLeft",
        "bottomRight",
        "stretch"
      ],
      "default": "edge"
    },
    "direction": {
      "type": "string",
      "enum": [
        "row",
        "row-reverse"
      ],
      "default": "row"
    },
    "spacing": {
      "type": "number",
      "default": 2
    },
    "justify": {
      "type": "string",
      "enum": [
        "",
        "flex-start",
        "center",
        "flex-end",
        "space-between",
        "space-around",
        "space-evenly"
      ],
      "default": ""
    },
    "wrap": {
      "type": "boolean",
      "default": false
    },
    "expanded": {
      "type": "boolean",
      "default": true
    },
    "includeSpacer": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}