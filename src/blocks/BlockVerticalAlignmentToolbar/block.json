{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/block-vertical-alignment-toolbar",
	"version": "0.1.0",
	"title": "BlockVerticalAlignmentToolbar",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the BlockVerticalAlignmentToolbar component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"enum": [
				"",
				"top",
				"center",
				"bottom",
				"stretch",
				"space-between"
			],
			"default": ""
		},
		"label": {
			"type": "string",
			"default": "Align content vertically"
		},
		"controlsSet": {
			"type": "string",
			"enum": [ "default", "all", "distribute" ],
			"default": "default"
		},
		"isCollapsed": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
