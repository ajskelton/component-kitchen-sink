{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/radio",
  "version": "0.1.0",
  "title": "Radio",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Radio component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "checked": {
      "type": "string",
      "default": "second"
    },
    "value": {
      "type": "string",
      "default": "second"
    },
    "text": {
      "type": "string",
      "default": ""
    },
    "disabled": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}