{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/block-format-controls",
	"version": "0.1.0",
	"title": "BlockFormatControls",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the BlockFormatControls component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"label": {
			"type": "string",
			"default": "BlockFormatControls button"
		},
		"active": {
			"type": "boolean",
			"default": false
		},
		"clicks": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
