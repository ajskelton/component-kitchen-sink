{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-clipboard-handler",
  "version": "0.1.0",
  "title": "__unstableUseClipboardHandler",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the __unstableUseClipboardHandler component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "copyCount": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}