{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/tooltip",
  "version": "0.1.0",
  "title": "Tooltip",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Tooltip component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": "Tooltip text"
    },
    "shortcut": {
      "type": "string",
      "default": ""
    },
    "placement": {
      "type": "string",
      "enum": [
        "top",
        "top-start",
        "top-end",
        "right",
        "bottom",
        "bottom-start",
        "bottom-end",
        "left"
      ],
      "default": "top"
    },
    "delay": {
      "type": "number",
      "default": 700
    },
    "hideOnClick": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}