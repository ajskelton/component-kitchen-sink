{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/text-highlight",
  "version": "0.1.0",
  "title": "TextHighlight",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the TextHighlight component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": "Highlight every match of the highlight text, ignoring case."
    },
    "highlight": {
      "type": "string",
      "default": "highlight"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}