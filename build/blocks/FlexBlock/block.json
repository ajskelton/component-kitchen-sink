{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/flex-block",
  "version": "0.1.0",
  "title": "FlexBlock",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the FlexBlock component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "display": {
      "type": "string",
      "enum": [
        "",
        "block",
        "inline-block",
        "flex",
        "inline-flex"
      ],
      "default": ""
    },
    "text": {
      "type": "string",
      "default": "FlexBlock grows to fill the free space"
    },
    "gap": {
      "type": "number",
      "default": 2
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}