{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/url-input-button",
	"version": "0.1.0",
	"title": "URLInputButton",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the URLInputButton component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"url": {
			"type": "string",
			"default": ""
		},
		"text": {
			"type": "string",
			"default": "Click here"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
