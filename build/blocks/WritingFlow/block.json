{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/writing-flow",
  "version": "0.1.0",
  "title": "WritingFlow",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the WritingFlow component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "blockCount": {
      "type": "number",
      "default": 3
    },
    "ariaLabel": {
      "type": "string",
      "default": "Nested writing flow"
    },
    "className": {
      "type": "string",
      "default": "ajs-writing-flow"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}