{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/tool-selector",
  "version": "0.1.0",
  "title": "ToolSelector",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ToolSelector component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "render": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}