{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/slot-fill-provider",
  "version": "0.1.0",
  "title": "SlotFillProvider",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the SlotFillProvider component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "nested": {
      "type": "boolean",
      "default": false
    },
    "passthrough": {
      "type": "boolean",
      "default": false
    },
    "outerFill": {
      "type": "boolean",
      "default": true
    },
    "innerFill": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}