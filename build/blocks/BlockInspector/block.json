{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/block-inspector",
  "version": "0.1.0",
  "title": "BlockInspector",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the BlockInspector component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "blockCount": {
      "type": "number",
      "default": 3
    },
    "preselect": {
      "type": "boolean",
      "default": true
    },
    "selectedIndex": {
      "type": "number",
      "default": 1
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}