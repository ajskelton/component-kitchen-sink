{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/height-control",
  "version": "0.1.0",
  "title": "HeightControl",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the HeightControl component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "value": {
      "type": "string",
      "default": ""
    },
    "label": {
      "type": "string",
      "default": "Height"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}