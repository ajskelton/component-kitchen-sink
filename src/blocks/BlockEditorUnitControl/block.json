{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/block-editor-unit-control",
	"version": "0.1.0",
	"title": "UnitControl",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the UnitControl component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"default": "10px"
		},
		"label": {
			"type": "string",
			"default": "Width"
		},
		"unitsPreset": {
			"type": "string",
			"enum": [ "default", "px-em", "percent" ],
			"default": "default"
		},
		"size": {
			"type": "string",
			"enum": [ "default", "small", "compact" ],
			"default": "default"
		},
		"min": {
			"type": "number",
			"default": 0
		},
		"max": {
			"type": "number",
			"default": 500
		},
		"step": {
			"type": "number",
			"default": 1
		},
		"spinControls": {
			"type": "string",
			"enum": [ "none", "custom", "native" ],
			"default": "native"
		},
		"disableUnits": {
			"type": "boolean",
			"default": false
		},
		"isResetValueOnUnitChange": {
			"type": "boolean",
			"default": false
		},
		"disabled": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
