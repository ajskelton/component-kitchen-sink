{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/copy-handler",
	"version": "0.1.0",
	"title": "CopyHandler",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the CopyHandler component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"blockCount": {
			"type": "number",
			"default": 2
		},
		"className": {
			"type": "string",
			"default": "ajs-copy-handler"
		},
		"copyEvents": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
