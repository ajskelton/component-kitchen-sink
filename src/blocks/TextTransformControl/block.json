{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/text-transform-control",
	"version": "0.1.0",
	"title": "TextTransformControl",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the TextTransformControl component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"enum": [ "", "none", "uppercase", "lowercase", "capitalize" ],
			"default": ""
		},
		"className": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
