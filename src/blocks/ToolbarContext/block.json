{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/toolbar-context",
	"version": "0.1.0",
	"title": "__experimentalToolbarContext",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the __experimentalToolbarContext component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"hasToolbar": {
			"type": "boolean",
			"default": true
		},
		"clicks": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
