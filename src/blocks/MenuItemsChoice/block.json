{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/menu-items-choice",
	"version": "0.1.0",
	"title": "MenuItemsChoice",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the MenuItemsChoice component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"enum": [ "one", "two", "three" ],
			"default": "one"
		},
		"showInfo": {
			"type": "boolean",
			"default": false
		},
		"showShortcut": {
			"type": "boolean",
			"default": false
		},
		"disableThird": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
