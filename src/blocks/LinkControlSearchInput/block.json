{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/link-control-search-input",
	"version": "0.1.0",
	"title": "LinkControlSearchInput",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the LinkControlSearchInput component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"value": {
			"type": "string",
			"default": ""
		},
		"placeholder": {
			"type": "string",
			"default": "Search or type URL"
		},
		"showSuggestions": {
			"type": "boolean",
			"default": true
		},
		"allowDirectEntry": {
			"type": "boolean",
			"default": true
		},
		"showInitialSuggestions": {
			"type": "boolean",
			"default": false
		},
		"withCreateSuggestion": {
			"type": "boolean",
			"default": false
		},
		"hideLabelFromVision": {
			"type": "boolean",
			"default": false
		},
		"isEntity": {
			"type": "boolean",
			"default": false
		},
		"selectedUrl": {
			"type": "string",
			"default": ""
		},
		"selectedTitle": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
