{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/duotone-swatch",
  "version": "0.1.0",
  "title": "DuotoneSwatch",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the DuotoneSwatch component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "shadow": {
      "type": "string",
      "default": "#000000"
    },
    "highlight": {
      "type": "string",
      "default": "#ffffff"
    },
    "showPlaceholder": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}