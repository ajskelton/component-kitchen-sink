{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/toolbar",
  "version": "0.1.0",
  "title": "Toolbar",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Toolbar component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Options"
    },
    "variant": {
      "type": "string",
      "enum": [
        "",
        "unstyled"
      ],
      "default": ""
    },
    "orientation": {
      "type": "string",
      "enum": [
        "horizontal",
        "vertical"
      ],
      "default": "horizontal"
    },
    "pressed": {
      "type": "string",
      "default": "bold"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}