{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-block-commands",
  "version": "0.1.0",
  "title": "useBlockCommands",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the useBlockCommands component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "registerLoader": {
      "type": "boolean",
      "default": true
    },
    "maxItems": {
      "type": "number",
      "default": 8
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}