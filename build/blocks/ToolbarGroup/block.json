{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/toolbar-group",
  "version": "0.1.0",
  "title": "ToolbarGroup",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the ToolbarGroup component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "isCollapsed": {
      "type": "boolean",
      "default": false
    },
    "title": {
      "type": "string",
      "default": "Alignment"
    },
    "activeControl": {
      "type": "string",
      "enum": [
        "left",
        "center",
        "right"
      ],
      "default": "left"
    },
    "split": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}