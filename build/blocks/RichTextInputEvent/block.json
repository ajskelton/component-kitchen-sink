{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/rich-text-input-event",
  "version": "0.1.0",
  "title": "RichTextInputEvent",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the RichTextInputEvent component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "content": {
      "type": "string",
      "default": "Focus here, then press Cmd/Ctrl+B or Cmd/Ctrl+I."
    },
    "inputType": {
      "type": "string",
      "enum": [
        "formatBold",
        "formatItalic",
        "formatUnderline",
        "insertFromPaste",
        "deleteByCut"
      ],
      "default": "formatBold"
    },
    "handled": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}