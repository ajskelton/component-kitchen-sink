{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/autocomplete",
	"version": "0.1.0",
	"title": "Autocomplete",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Autocomplete component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": ""
		},
		"triggerPrefix": {
			"type": "string",
			"default": "~"
		},
		"isDebounced": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
