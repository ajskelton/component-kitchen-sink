{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/spinner",
	"version": "0.1.0",
	"title": "Spinner",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Spinner component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"size": {
			"type": "number",
			"default": 32
		},
		"showLabel": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
