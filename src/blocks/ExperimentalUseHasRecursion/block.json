{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/experimental-use-has-recursion",
	"version": "0.1.0",
	"title": "__experimentalUseHasRecursion",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the __experimentalUseHasRecursion component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"levels": {
			"type": "number",
			"default": 3
		},
		"sameId": {
			"type": "boolean",
			"default": false
		},
		"blockName": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
