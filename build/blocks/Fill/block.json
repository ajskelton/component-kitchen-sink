{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/fill",
  "version": "0.1.0",
  "title": "Fill",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Fill component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "slotName": {
      "type": "string",
      "default": "ajs-demo-slot"
    },
    "fillVisible": {
      "type": "boolean",
      "default": true
    },
    "mode": {
      "type": "string",
      "enum": [
        "node",
        "function"
      ],
      "default": "node"
    },
    "fillText": {
      "type": "string",
      "default": "Fill content"
    },
    "clicks": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}