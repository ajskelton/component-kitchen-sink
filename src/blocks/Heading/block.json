{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/heading",
	"version": "0.1.0",
	"title": "Heading",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Heading component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"text": {
			"type": "string",
			"default": "A heading rendered by Heading"
		},
		"level": {
			"type": "number",
			"enum": [ 1, 2, 3, 4, 5, 6 ],
			"default": 2
		},
		"align": {
			"type": "string",
			"enum": [ "", "left", "center", "right", "justify" ],
			"default": ""
		},
		"color": {
			"type": "string",
			"default": ""
		},
		"weight": {
			"type": "string",
			"default": ""
		},
		"isBlock": {
			"type": "boolean",
			"default": true
		},
		"isDestructive": {
			"type": "boolean",
			"default": false
		},
		"truncate": {
			"type": "boolean",
			"default": false
		},
		"upperCase": {
			"type": "boolean",
			"default": false
		},
		"letterSpacing": {
			"type": "string",
			"default": ""
		},
		"lineHeight": {
			"type": "string",
			"default": ""
		},
		"highlightWords": {
			"type": "string",
			"default": ""
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
