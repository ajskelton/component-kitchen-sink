{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/with-colors",
	"version": "0.1.0",
	"title": "withColors",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the withColors component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"backgroundColor": {
			"type": "string"
		},
		"customBackgroundColor": {
			"type": "string"
		},
		"textColor": {
			"type": "string"
		},
		"customTextColor": {
			"type": "string"
		},
		"label": {
			"type": "string",
			"default": "Box colored through withColors"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
