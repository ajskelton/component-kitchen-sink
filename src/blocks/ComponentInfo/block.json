{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/component-info",
	"version": "0.1.0",
	"title": "Component Info",
	"category": "ajs-kitchen-sink",
	"icon": "info-outline",
	"description": "Shows where the component this post describes is used by core blocks and how it has changed over time; the summary variant is a one-line card for archives",
	"usesContext": [
		"postId",
		"postType"
	],
	"supports": {
		"html": false,
		"multiple": false,
		"reusable": false
	},
	"attributes": {
		"variant": {
			"type": "string",
			"enum": [
				"full",
				"summary"
			],
			"default": "full"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
