{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/item",
	"version": "0.1.0",
	"title": "Item",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Item component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"size": {
			"type": "string",
			"enum": [ "small", "medium", "large" ],
			"default": "medium"
		},
		"text": {
			"type": "string",
			"default": "Item"
		},
		"clickable": {
			"type": "boolean",
			"default": true
		},
		"clicks": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
