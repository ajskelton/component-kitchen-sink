{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/use-style-override",
  "version": "0.1.0",
  "title": "useStyleOverride",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the useStyleOverride component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "overrideId": {
      "type": "string",
      "default": ""
    },
    "css": {
      "type": "string",
      "default": ".wp-block-ajs-use-style-override .ajs-style-override-target {\n\tbackground: #ffe0f0;\n\toutline: 3px dashed hotpink;\n\tpadding: 1em;\n}"
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}