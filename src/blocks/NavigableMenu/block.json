{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/navigable-menu",
	"version": "0.1.0",
	"title": "NavigableMenu",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the NavigableMenu component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"orientation": {
			"type": "string",
			"enum": [ "vertical", "horizontal", "both" ],
			"default": "vertical"
		},
		"cycle": {
			"type": "boolean",
			"default": true
		},
		"lastIndex": {
			"type": "number",
			"default": -1
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
