{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/elevation",
  "version": "0.1.0",
  "title": "Elevation",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the Elevation component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "value": {
      "type": "number",
      "default": 5
    },
    "hover": {
      "type": "number",
      "default": 0
    },
    "focus": {
      "type": "number",
      "default": 0
    },
    "active": {
      "type": "number",
      "default": 0
    },
    "isInteractive": {
      "type": "boolean",
      "default": false
    },
    "borderRadius": {
      "type": "string",
      "default": "8px"
    },
    "offset": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}