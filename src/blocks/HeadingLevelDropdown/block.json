{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/heading-level-dropdown",
	"version": "0.1.0",
	"title": "HeadingLevelDropdown",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the HeadingLevelDropdown component from @wordpress/block-editor",
	"supports": {
		"html": false
	},
	"attributes": {
		"level": {
			"type": "number",
			"enum": [ 0, 1, 2, 3, 4, 5, 6 ],
			"default": 2
		},
		"optionsPreset": {
			"type": "string",
			"enum": [ "default", "with-paragraph", "h2-h4" ],
			"default": "default"
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
