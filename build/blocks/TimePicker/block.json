{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/time-picker",
  "version": "0.1.0",
  "title": "TimePicker",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the TimePicker component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "currentTime": {
      "type": "string",
      "default": ""
    },
    "is12Hour": {
      "type": "boolean",
      "default": false
    },
    "dateOrder": {
      "type": "string",
      "enum": [
        "mdy",
        "dmy",
        "ymd"
      ],
      "default": "mdy"
    },
    "hideLabelFromVision": {
      "type": "boolean",
      "default": false
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}