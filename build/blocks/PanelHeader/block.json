{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/panel-header",
  "version": "0.1.0",
  "title": "PanelHeader",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the PanelHeader component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "label": {
      "type": "string",
      "default": "Panel header label"
    },
    "showChildren": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}