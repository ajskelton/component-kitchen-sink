{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/visually-hidden",
  "version": "0.1.0",
  "title": "VisuallyHidden",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the VisuallyHidden component from @wordpress/components",
  "supports": {
    "html": false
  },
  "attributes": {
    "text": {
      "type": "string",
      "default": "This text is only for screen readers."
    },
    "as": {
      "type": "string",
      "enum": [
        "div",
        "span",
        "h4"
      ],
      "default": "div"
    },
    "showMirror": {
      "type": "boolean",
      "default": true
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}