{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/with-spoken-messages",
	"version": "0.1.0",
	"title": "withSpokenMessages",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the withSpokenMessages component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"message": {
			"type": "string",
			"default": "Spoken message"
		},
		"politeness": {
			"type": "string",
			"enum": [ "polite", "assertive" ],
			"default": "polite"
		},
		"lastSpoken": {
			"type": "string",
			"default": ""
		},
		"speakCount": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
