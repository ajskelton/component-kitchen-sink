{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ajs/block-controls",
  "version": "0.1.0",
  "title": "BlockControls",
  "category": "ajs-kitchen-sink",
  "icon": "smiley",
  "description": "Exercises the BlockControls component from @wordpress/block-editor",
  "supports": {
    "html": false
  },
  "attributes": {
    "group": {
      "type": "string",
      "enum": [
        "default",
        "block",
        "other",
        "inline"
      ],
      "default": "default"
    },
    "label": {
      "type": "string",
      "default": "BlockControls button"
    },
    "useControlsProp": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": false
    },
    "clicks": {
      "type": "number",
      "default": 0
    }
  },
  "textdomain": "component-kitchen-sink",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}