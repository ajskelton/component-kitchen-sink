{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/guide",
	"version": "0.1.0",
	"title": "Guide",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the Guide component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"contentLabel": {
			"type": "string",
			"default": "Guide demo"
		},
		"pageCount": {
			"type": "number",
			"default": 3
		},
		"finishButtonText": {
			"type": "string",
			"default": ""
		},
		"nextButtonText": {
			"type": "string",
			"default": ""
		},
		"previousButtonText": {
			"type": "string",
			"default": ""
		},
		"timesOpened": {
			"type": "number",
			"default": 0
		},
		"timesFinished": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
