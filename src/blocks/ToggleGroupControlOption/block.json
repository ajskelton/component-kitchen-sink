{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/toggle-group-control-option",
	"version": "0.1.0",
	"title": "ToggleGroupControlOption",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the ToggleGroupControlOption component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"selected": {
			"type": "string",
			"default": "second"
		},
		"value": {
			"type": "string",
			"default": "second"
		},
		"label": {
			"type": "string",
			"default": "Second"
		},
		"showTooltip": {
			"type": "boolean",
			"default": false
		},
		"disabled": {
			"type": "boolean",
			"default": false
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
