{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "ajs/box-control",
	"version": "0.1.0",
	"title": "BoxControl",
	"category": "ajs-kitchen-sink",
	"icon": "smiley",
	"description": "Exercises the BoxControl component from @wordpress/components",
	"supports": {
		"html": false
	},
	"attributes": {
		"values": {
			"type": "object",
			"default": {}
		},
		"label": {
			"type": "string",
			"default": "Padding"
		},
		"allowReset": {
			"type": "boolean",
			"default": true
		},
		"splitOnAxis": {
			"type": "boolean",
			"default": false
		},
		"sides": {
			"type": "string",
			"enum": [
				"all",
				"horizontal",
				"vertical",
				"top-bottom",
				"left-right",
				"top"
			],
			"default": "all"
		},
		"units": {
			"type": "string",
			"enum": [ "default", "px, em, %", "px only" ],
			"default": "default"
		},
		"usePresets": {
			"type": "boolean",
			"default": false
		},
		"inputPropsMin": {
			"type": "number",
			"default": 0
		}
	},
	"textdomain": "component-kitchen-sink",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
